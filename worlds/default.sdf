<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="default">
    <physics type="ode">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
      <!-- Optional: Set a default global ambient temperature in Kelvin -->
      <temperature>300.0</temperature> 
    </plugin>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ======================== GROUND PLANE ======================== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <temperature>293.15</temperature>
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>300 300</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>300 300</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ====================== OBSTACLE PILLAR CLUSTER ====================== -->

    <!-- Pillar 1 -->
    <model name="pillar_1"><static>true</static><pose>5 1 2 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><cylinder><radius>0.4</radius><length>4</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.4</radius><length>4</length></cylinder></geometry>
      <material><diffuse>0.8 0.2 0.2 1</diffuse></material></visual></link></model>

    <!-- Pillar 2 -->
    <model name="pillar_2"><static>true</static><pose>7 -2 2 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><cylinder><radius>0.4</radius><length>4</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.4</radius><length>4</length></cylinder></geometry>
      <material><diffuse>0.8 0.2 0.2 1</diffuse></material></visual></link></model>

    <!-- Pillar 3 -->
    <model name="pillar_3"><static>true</static><pose>3 -4 2.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><cylinder><radius>0.35</radius><length>5</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.35</radius><length>5</length></cylinder></geometry>
      <material><diffuse>0.8 0.2 0.2 1</diffuse></material></visual></link></model>

    <!-- Pillar 4 -->
    <model name="pillar_4"><static>true</static><pose>9 5 3 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><cylinder><radius>0.45</radius><length>6</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.45</radius><length>6</length></cylinder></geometry>
      <material><diffuse>0.8 0.2 0.2 1</diffuse></material></visual></link></model>

    <!-- Pillar 5 -->
    <model name="pillar_5"><static>true</static><pose>-5 8 2 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><cylinder><radius>0.4</radius><length>4</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.4</radius><length>4</length></cylinder></geometry>
      <material><diffuse>0.8 0.2 0.2 1</diffuse></material></visual></link></model>

    <!-- ====================== BUILDINGS (Box Obstacles) ====================== -->

    <!-- Building 1 - tall -->
    <model name="building_1"><static>true</static><pose>15 8 5 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>4 4 10</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>4 4 10</size></box></geometry>
        <material><diffuse>0.3 0.3 0.7 1</diffuse></material></visual>
      </link></model>

    <!-- Building 2 - wide -->
    <model name="building_2"><static>true</static><pose>-10 5 3 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>6 3 6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6 3 6</size></box></geometry>
        <material><diffuse>0.3 0.6 0.3 1</diffuse></material></visual>
      </link></model>

    <!-- Building 3 - medium -->
    <model name="building_3"><static>true</static><pose>-15 -8 4 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>5 5 8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>5 5 8</size></box></geometry>
        <material><diffuse>0.6 0.4 0.2 1</diffuse></material></visual>
      </link></model>

    <!-- Building 4 - low flat -->
    <model name="building_4"><static>true</static><pose>25 -10 2 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>8 6 4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8 6 4</size></box></geometry>
        <material><diffuse>0.5 0.5 0.2 1</diffuse></material></visual>
      </link></model>
   
    <!-- ====================== ARCH / GATE STRUCTURES ====================== -->

  
   

    <!-- Gate top beam -->
    <model name="gate_top"><static>true</static><pose>13.5 0 4.75 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.5 8 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 8 0.5</size></box></geometry>
        <material><diffuse>0.2 0.2 0.8 1</diffuse></material></visual>
      </link></model>

    <!-- ====================== WALL WITH HOLE ====================== -->
    <model name="wall_with_hole">
      <static>true</static>
      <pose>20 0 2 0 0 0</pose>
      <link name="wall_left">
        <pose>0 3 0 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 4 4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 4 4</size></box></geometry><material><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>
      </model>
      
    <!-- ====================== FLOATING RINGS / NARROW TUNNELS ====================== -->

    <!-- Floating ring obstacle 1 (sphere shell approximation with 4 boxes) - top bar -->
    <model name="ring1_top"><static>true</static><pose>35 0 6 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.3 5 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.3 5 0.5</size></box></geometry>
        <material><diffuse>1 0.5 0 1</diffuse></material></visual>
      </link></model>
    <!-- ring1 bottom bar -->
    <model name="ring1_bot"><static>true</static><pose>35 0 3 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.3 5 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.3 5 0.5</size></box></geometry>
        <material><diffuse>1 0.5 0 1</diffuse></material></visual>
      </link></model>
    <!-- ring1 left post -->
    <model name="ring1_left"><static>true</static><pose>35 2.25 4.5 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.3 0.5 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.3 0.5 3</size></box></geometry>
        <material><diffuse>1 0.5 0 1</diffuse></material></visual>
      </link></model>
    <!-- ring1 right post -->
    <model name="ring1_right"><static>true</static><pose>35 -2.25 4.5 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.3 0.5 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.3 0.5 3</size></box></geometry>
        <material><diffuse>1 0.5 0 1</diffuse></material></visual>
      </link></model>

    <!-- ====================== RANDOM SCATTERED OBSTACLES ====================== -->

    <!-- Box obstacle cluster near start -->
    <model name="box_obs_1"><static>true</static><pose>-3 3 1 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>1.5 1.5 2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.5 1.5 2</size></box></geometry>
        <material><diffuse>0.9 0.6 0.1 1</diffuse></material></visual>
      </link></model>

    <model name="box_obs_2"><static>true</static><pose>-6 -3 1.5 0 0 0.5</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>2 1 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2 1 3</size></box></geometry>
        <material><diffuse>0.1 0.8 0.8 1</diffuse></material></visual>
      </link></model>

    

    <model name="box_obs_4"><static>true</static><pose>-20 10 1 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>3 3 2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3 3 2</size></box></geometry>
        <material><diffuse>0.6 0.1 0.6 1</diffuse></material></visual>
      </link></model>

    <model name="sphere_obs_1"><static>true</static><pose>40 -5 3 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><sphere><radius>2.5</radius></sphere></geometry></collision>
        <visual name="v"><geometry><sphere><radius>2.5</radius></sphere></geometry>
        <material><diffuse>0.9 0.1 0.5 1</diffuse></material></visual>
      </link></model>

    

    <!-- Tall narrow spike -->
    <model name="spike_1"><static>true</static><pose>-8 -15 5 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><cylinder><radius>0.2</radius><length>10</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.2</radius><length>10</length></cylinder></geometry>
        <material><diffuse>1 0 0 1</diffuse></material></visual>
      </link></model>

    <model name="spike_2"><static>true</static><pose>-10 -15 4 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><cylinder><radius>0.2</radius><length>8</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.2</radius><length>8</length></cylinder></geometry>
        <material><diffuse>1 0 0 1</diffuse></material></visual>
      </link></model>

    <model name="spike_3"><static>true</static><pose>-12 -15 3.5 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><cylinder><radius>0.2</radius><length>7</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.2</radius><length>7</length></cylinder></geometry>
        <material><diffuse>1 0 0 1</diffuse></material></visual>
      </link></model>

    <!-- ======================== GOAL MARKER ======================== -->
    <model name="final_goal_marker">
      <static>true</static>
      <pose>50 0 2 0 0 0</pose>
      <link name="l">
        <visual name="v">
          <geometry><cylinder><radius>0.6</radius><length>4</length></cylinder></geometry>
          <material><diffuse>0 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         NO-FLY ZONES  (flat red plates on ground, 0.1m thick)
         Drone avoidance AI should treat these as restricted areas.
         Name convention: nofly_zone_N
    ============================================================ -->

    <!-- No-fly zone 1: Near start area (danger zone) -->
    <model name="nofly_zone_1">
      <static>true</static>
      <pose>8 -8 0.05 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>10 10 0.1</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>10 10 0.1</size></box></geometry>
          <material>
            <ambient>0.9 0.0 0.0 0.6</ambient>
            <diffuse>0.9 0.0 0.0 0.6</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- No-fly zone 2: Mid-field hazard area -->
    <model name="nofly_zone_2">
      <static>true</static>
      <pose>-15 15 0.05 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>12 8 0.1</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>12 8 0.1</size></box></geometry>
          <material>
            <ambient>0.9 0.0 0.0 0.6</ambient>
            <diffuse>0.9 0.0 0.0 0.6</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- No-fly zone 3: Far right restricted runway -->
    <model name="nofly_zone_3">
      <static>true</static>
      <pose>40 10 0.05 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>15 6 0.1</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>15 6 0.1</size></box></geometry>
          <material>
            <ambient>0.9 0.0 0.0 0.6</ambient>
            <diffuse>0.9 0.0 0.0 0.6</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- No-fly zone 4: Behind-building restricted zone -->
    <model name="nofly_zone_4">
      <static>true</static>
      <pose>-20 -15 0.05 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>10 10 0.1</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>10 10 0.1</size></box></geometry>
          <material>
            <ambient>0.9 0.0 0.0 0.6</ambient>
            <diffuse>0.9 0.0 0.0 0.6</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         EXTRA OBSTACLES BATCH 2 — Added in second pass
    ============================================================ -->

    <!-- === ZIGZAG WALL MAZE (x=45..55 corridor) === -->
    <model name="zzwall_1"><static>true</static><pose>45 3 2.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.3 10 5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.3 10 5</size></box></geometry>
      <material><diffuse>0.4 0.4 0.9 1</diffuse></material></visual></link></model>

    <model name="zzwall_2"><static>true</static><pose>48 -3 2.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.3 10 5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.3 10 5</size></box></geometry>
      <material><diffuse>0.4 0.4 0.9 1</diffuse></material></visual></link></model>

    <model name="zzwall_3"><static>true</static><pose>51 3 2.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.3 10 5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.3 10 5</size></box></geometry>
      <material><diffuse>0.4 0.4 0.9 1</diffuse></material></visual></link></model>

    <model name="zzwall_4"><static>true</static><pose>54 -3 2.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.3 10 5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.3 10 5</size></box></geometry>
      <material><diffuse>0.4 0.4 0.9 1</diffuse></material></visual></link></model>

    <!-- === ELEVATED PLATFORM with legs === -->
    <model name="platform_top"><static>true</static><pose>-30 5 5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>8 6 0.4</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>8 6 0.4</size></box></geometry>
      <material><diffuse>0.5 0.3 0.1 1</diffuse></material></visual></link></model>

    <model name="platform_leg1"><static>true</static><pose>-27 7 2.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><cylinder><radius>0.2</radius><length>5</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.2</radius><length>5</length></cylinder></geometry>
      <material><diffuse>0.4 0.2 0.1 1</diffuse></material></visual></link></model>

    <model name="platform_leg2"><static>true</static><pose>-33 7 2.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><cylinder><radius>0.2</radius><length>5</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.2</radius><length>5</length></cylinder></geometry>
      <material><diffuse>0.4 0.2 0.1 1</diffuse></material></visual></link></model>

    <model name="platform_leg3"><static>true</static><pose>-27 3 2.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><cylinder><radius>0.2</radius><length>5</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.2</radius><length>5</length></cylinder></geometry>
      <material><diffuse>0.4 0.2 0.1 1</diffuse></material></visual></link></model>

    <model name="platform_leg4"><static>true</static><pose>-33 3 2.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><cylinder><radius>0.2</radius><length>5</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.2</radius><length>5</length></cylinder></geometry>
      <material><diffuse>0.4 0.2 0.1 1</diffuse></material></visual></link></model>

   
    <!-- Tunnel right wall -->
    <model name="tunnel_right"><static>true</static><pose>-35 -11 3 0 0 1.5708</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.3 12 6</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.3 12 6</size></box></geometry>
      <material><diffuse>0.3 0.3 0.3 1</diffuse></material></visual></link></model>
   

    <!-- === TREE GROVE (cylinders = trunks, spheres = canopy) === -->
    <model name="tree_trunk_1"><static>true</static><pose>-2 20 3 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><cylinder><radius>0.25</radius><length>6</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.25</radius><length>6</length></cylinder></geometry>
      <material><diffuse>0.4 0.2 0.0 1</diffuse></material></visual></link></model>
    <model name="tree_canopy_1"><static>true</static><pose>-2 20 7 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><sphere><radius>1.8</radius></sphere></geometry></collision>
      <visual name="v"><geometry><sphere><radius>1.8</radius></sphere></geometry>
      <material><diffuse>0.1 0.6 0.1 1</diffuse></material></visual></link></model>

    <model name="tree_trunk_2"><static>true</static><pose>2 22 3 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><cylinder><radius>0.2</radius><length>6</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.2</radius><length>6</length></cylinder></geometry>
      <material><diffuse>0.4 0.2 0.0 1</diffuse></material></visual></link></model>
    <model name="tree_canopy_2"><static>true</static><pose>2 22 7 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><sphere><radius>1.5</radius></sphere></geometry></collision>
      <visual name="v"><geometry><sphere><radius>1.5</radius></sphere></geometry>
      <material><diffuse>0.1 0.6 0.1 1</diffuse></material></visual></link></model>

    <model name="tree_trunk_3"><static>true</static><pose>-5 25 3 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><cylinder><radius>0.22</radius><length>6</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.22</radius><length>6</length></cylinder></geometry>
      <material><diffuse>0.4 0.2 0.0 1</diffuse></material></visual></link></model>
    <model name="tree_canopy_3"><static>true</static><pose>-5 25 7 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><sphere><radius>1.6</radius></sphere></geometry></collision>
      <visual name="v"><geometry><sphere><radius>1.6</radius></sphere></geometry>
      <material><diffuse>0.1 0.6 0.1 1</diffuse></material></visual></link></model>

    <model name="tree_trunk_4"><static>true</static><pose>5 18 2.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><cylinder><radius>0.3</radius><length>5</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.3</radius><length>5</length></cylinder></geometry>
      <material><diffuse>0.4 0.2 0.0 1</diffuse></material></visual></link></model>
    <model name="tree_canopy_4"><static>true</static><pose>5 18 6.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><sphere><radius>2.0</radius></sphere></geometry></collision>
      <visual name="v"><geometry><sphere><radius>2.0</radius></sphere></geometry>
      <material><diffuse>0.1 0.6 0.1 1</diffuse></material></visual></link></model>

    <!-- === SUSPENDED BEAMS (aerial obstacles at drone cruising height) === -->
    <model name="beam_1"><static>true</static><pose>25 0 6 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.4 18 0.4</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.4 18 0.4</size></box></geometry>
      <material><diffuse>0.9 0.4 0.0 1</diffuse></material></visual></link></model>

    <model name="beam_2"><static>true</static><pose>32 0 4.5 0 0 1.5708</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.4 14 0.4</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.4 14 0.4</size></box></geometry>
      <material><diffuse>0.9 0.4 0.0 1</diffuse></material></visual></link></model>

    <model name="beam_3"><static>true</static><pose>-18 -5 7 0 0 0.4</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.3 20 0.3</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.3 20 0.3</size></box></geometry>
      <material><diffuse>0.9 0.4 0.0 1</diffuse></material></visual></link></model>

   

    <!-- === DENSE BOX CLUSTER (narrow slalom) === -->
    <model name="slalom_1"><static>true</static><pose>60 2 1.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>1 1 3</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>1 1 3</size></box></geometry>
